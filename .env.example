# Server Settings
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Must be a cloud MongoDB Atlas URI, not localhost!)
# Ensure 0.0.0.0/0 is added in MongoDB Atlas Network Access (IP Access List)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/crm_backend?retryWrites=true&w=majority

# Frontend URLs for CORS
FRONTEND_URL=https://your-frontend-domain.vercel.app
PRODUCTION_URL=https://your-frontend-domain.vercel.app

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_ACCESS_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h

# BCrypt Salt Rounds
BCRYPT_SALT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_MAX=100
LOG_LEVEL=info
